# File paths are intentionally used so credentials never enter Git or Docker image layers.
AEMET_API_KEY_PATH="docs/api_keys/AEMET Apikey/api.pem"
EUSKALMET_PRIVATE_KEY_PATH="docs/api_keys/Euskalmet Apikey/privateKey.pem"
EUSKALMET_LOGIN_ID_PATH="docs/api_keys/Euskalmet Apikey/fingerPrint.txt"
EUSKALMET_ISSUER=gipuzkoa-weather-climate-askbot
EUSKALMET_EMAIL=
# Optional provider-generated JWT for short-lived manual tests only.
# EUSKALMET_TOKEN_PATH="docs/api_keys/Euskalmet Apikey/token.txt"

# OpenAI and semantic retrieval
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-5.4-mini
RETRIEVAL_BACKEND=sqlite_fts5
SQLITE_DATABASE=data/snapshots/SNAPSHOT_ID/snapshot.sqlite
DATA_MODE=snapshot
LIVE_DATA_MAX_AGE_HOURS=3
SNAPSHOT_ROOT=data/snapshots
SOURCE_REVISION=

# Local pgvector service
POSTGRES_DB=gipuzkoa_askbot
POSTGRES_USER=gipuzkoa
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=

# Kestra local runtime. Secret paths must be absolute host paths.
KESTRA_PORT=8080
KESTRA_MANAGEMENT_PORT=8081
# Kestra requires the Basic Auth username to be a valid email address.
KESTRA_USERNAME=admin@kestra.io
# Required: generate a unique local password instead of using Kestra examples.
KESTRA_PASSWORD=
# Kestra OSS environment secrets are Base64-encoded.
KESTRA_SECRET_OPENAI_API_KEY_B64=
KESTRA_SECRET_DATABASE_URL_B64=
KESTRA_SECRET_EUSKALMET_EMAIL_B64=
KESTRA_SECRET_EUSKALMET_SECRET_DIR_B64=
KESTRA_SECRET_AEMET_SECRET_DIR_B64=
KESTRA_SECRET_CDS_CONFIG_PATH_B64=
